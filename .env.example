# PostgreSQL (local install / docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dronegrid
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:postgres@postgres:5432/dronegrid

# MongoDB (docker)
MONGO_USER=mongo
MONGO_PASSWORD=mongo
MONGO_DB=dronegrid
MONGO_PORT=27017
MONGO_URL=mongodb://mongo:27017/dronegrid

# Application
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
TELEMETRY_API_KEY=replace-with-a-random-telemetry-key
APP_PORT=3000
